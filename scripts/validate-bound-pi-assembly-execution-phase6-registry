#!/usr/bin/env bash
# Hermetic local-registry acceptance validator for OpenSpec change
# bound-pi-assembly-execution, Phase 6. The Python harness owns the temporary
# registry, fixtures and fault controls; this wrapper owns evidence and cleanup.
set -uo pipefail

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly HARNESS="tests/test_bound_pi_assembly_execution_phase6_registry.py"
readonly PREFIX="dc-bound-pi-phase6-registry"

usage() { printf 'Usage: %s [--evidence-dir DIR] [--local-config FILE]\n' "${0##*/}"; }
EVIDENCE_DIR=""
LOCAL_CONFIG="$ROOT/docker-constructor.local.toml"
while (($#)); do
  case "$1" in
    --evidence-dir)
      (($# >= 2)) || { usage >&2; exit 2; }
      EVIDENCE_DIR=$2; shift 2 ;;
    --local-config)
      (($# >= 2)) || { usage >&2; exit 2; }
      LOCAL_CONFIG=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'error: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
if [[ -z "$EVIDENCE_DIR" ]]; then
  EVIDENCE_DIR="$ROOT/validation-evidence/bound-pi-assembly-execution-phase6-registry-$(date -u +%Y%m%dT%H%M%SZ)"
fi
mkdir -p -- "$EVIDENCE_DIR" || exit 1
EVIDENCE_DIR="$(cd -- "$EVIDENCE_DIR" && pwd -P)"
readonly EVIDENCE_DIR
readonly LOG="$EVIDENCE_DIR/validation.log"
readonly REPORT="$EVIDENCE_DIR/report.json"
readonly RUN_ID="${PREFIX}-$$-$(date -u +%s)"
readonly RESOURCE_FILE="$EVIDENCE_DIR/assembler-containers.txt"
: > "$RESOURCE_FILE"
STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
STATUS=1
DETAIL="validation did not complete"

write_report() {
  local finished
  finished="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  VALIDATION_STATUS="$STATUS" VALIDATION_DETAIL="$DETAIL" \
  VALIDATION_STARTED="$STARTED" VALIDATION_FINISHED="$finished" \
  VALIDATION_RUN_ID="$RUN_ID" VALIDATION_LOG="$LOG" \
  python3 - "$REPORT" <<'PY'
import json, os, pathlib, sys
report = {
    "schema_version": 1,
    "change": "bound-pi-assembly-execution",
    "phase": 6,
    "tier": "host-with-ephemeral-local-registry",
    "run_id": os.environ["VALIDATION_RUN_ID"],
    "started_at": os.environ["VALIDATION_STARTED"],
    "finished_at": os.environ["VALIDATION_FINISHED"],
    "passed": os.environ["VALIDATION_STATUS"] == "0",
    "detail": os.environ["VALIDATION_DETAIL"],
    "log": os.environ["VALIDATION_LOG"],
    "public_npm_registry_used": False,
    "local_registry_ephemeral": True,
}
pathlib.Path(sys.argv[1]).write_text(json.dumps(report, sort_keys=True, indent=2) + "\n")
PY
}

cleanup() {
  local rc=$?
  if command -v docker >/dev/null 2>&1; then
    mapfile -t containers < <(sort -u "$RESOURCE_FILE" 2>/dev/null || true)
    ((${#containers[@]} == 0)) || docker rm -f "${containers[@]}" >/dev/null 2>&1 || true
    mapfile -t networks < <(docker network ls -q --filter "label=com.docker-constructor.phase6-run=$RUN_ID" 2>/dev/null || true)
    for network in "${networks[@]}"; do docker network rm "$network" >/dev/null 2>&1 || true; done
  fi
  [[ $STATUS -eq 0 ]] || STATUS=$rc
  write_report || true
  printf 'Evidence: %s\n' "$EVIDENCE_DIR"
}
trap cleanup EXIT INT TERM HUP

exec > >(tee -a "$LOG") 2>&1
cd -- "$ROOT"
printf '[%s] Starting local-registry validator; run_id=%s\n' "$STARTED" "$RUN_ID"

command -v docker >/dev/null 2>&1 || { DETAIL='docker executable is required'; exit 127; }
docker info >/dev/null 2>&1 || { DETAIL='Docker daemon is unavailable'; exit 1; }
[[ -f "$HARNESS" ]] || {
  DETAIL="Phase 6 local-registry harness is not implemented: $HARNESS"
  printf 'error: %s\n' "$DETAIL" >&2
  exit 3
}
[[ -f "$LOCAL_CONFIG" ]] || {
  DETAIL="local companion is required; run doctor or pass --local-config: $LOCAL_CONFIG"
  printf 'error: %s\n' "$DETAIL" >&2
  exit 2
}
HOST_ACCESS_ADDRESS="$(python3 - "$LOCAL_CONFIG" <<'PY'
import sys
from pathlib import Path
from docker.versioning.local_project_configuration import (
    load_local_project_configuration,
)
local = load_local_project_configuration(
    Path(sys.argv[1]), host_access_mode="docker-gateway"
)
address = local.host_access.address
if not address or address == "host-gateway":
    raise SystemExit("local [host-access].address must be a concrete diagnosed IP")
print(address)
PY
)" || { DETAIL='invalid local host-access configuration'; exit 2; }

export BOUND_PI_PHASE6_RUN_ID="$RUN_ID"
export BOUND_PI_PHASE6_EVIDENCE_DIR="$EVIDENCE_DIR"
export BOUND_PI_PHASE6_RESOURCE_FILE="$RESOURCE_FILE"
export BOUND_PI_PHASE6_HERMETIC=1
export BOUND_PI_PHASE6_FORBID_PUBLIC_REGISTRY=1
export BOUND_PI_PHASE6_HOST_ACCESS_ADDRESS="$HOST_ACCESS_ADDRESS"
printf 'Using diagnosed container-to-host address: %s\n' "$HOST_ACCESS_ADDRESS"

if ! python3 -m unittest -v tests.test_bound_pi_assembly_execution_phase6_registry; then
  DETAIL='local-registry acceptance harness failed'
  exit 1
fi

containers=""
while IFS= read -r name; do
  [[ -n "$name" ]] || continue
  if docker inspect "$name" >/dev/null 2>&1; then containers+="${containers:+ }$name"; fi
done < <(sort -u "$RESOURCE_FILE")
networks="$(docker network ls -q --filter "label=com.docker-constructor.phase6-run=$RUN_ID")"
if [[ -n "$containers$networks" ]]; then
  DETAIL='local-registry acceptance left labeled Docker resources'
  printf 'error: %s; containers=%s networks=%s\n' "$DETAIL" "${containers:-<none>}" "${networks:-<none>}" >&2
  exit 1
fi

STATUS=0
DETAIL='hermetic local-registry acceptance passed'
printf '[%s] PASS: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$DETAIL"
