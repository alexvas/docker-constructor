#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python="$repo_root/.venv/bin/python"

if [ ! -x "$python" ]; then
    echo "error: $python is required; see docs/python-checks.md" >&2
    exit 127
fi

PATH="$repo_root/.venv/bin:$PATH"
export PATH
exec "$python" "$repo_root/scripts/green_checks.py" "$@"
