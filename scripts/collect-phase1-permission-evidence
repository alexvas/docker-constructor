#!/usr/bin/env python3
"""Collect host ownership/mode evidence for OpenSpec task 1.12.

Run this as the original invoking user before and after independently changing
ownership/permissions of the constructor project and mounted workspaces.
The collector never follows symlinks and never mutates inspected paths.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import stat
from datetime import datetime, timezone
from pathlib import Path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--constructor-project", required=True, type=Path)
    parser.add_argument("--primary-workspace", required=True, type=Path)
    parser.add_argument("--extra-workspace", action="append", default=[], type=Path)
    parser.add_argument(
        "--cache-root",
        type=Path,
        help="Resolved constructor cache root (defaults to $XDG_CACHE_HOME/docker-constructor or ~/.cache/docker-constructor)",
    )
    parser.add_argument("--unrelated", action="append", default=[], type=Path)
    parser.add_argument(
        "--label", required=True, help="Evidence stage, for example before or after"
    )
    parser.add_argument("--output", required=True, type=Path)
    return parser.parse_args()


def canonical_directory(path: Path, label: str) -> Path:
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise SystemExit(f"error: cannot resolve {label} {path}: {exc}") from exc
    if not resolved.is_dir():
        raise SystemExit(f"error: {label} is not a directory: {resolved}")
    return resolved


def default_cache_root() -> Path:
    xdg = os.environ.get("XDG_CACHE_HOME")
    if xdg and os.path.isabs(xdg):
        return Path(xdg) / "docker-constructor"
    return Path.home() / ".cache" / "docker-constructor"


def safe_basename(value: str) -> str:
    rendered = "".join(
        char
        if (
            "A" <= char <= "Z"
            or "a" <= char <= "z"
            or "0" <= char <= "9"
            or char in "._-"
        )
        else "-"
        for char in value
    )
    return rendered.strip(".-") or "project"


def project_namespace(project: Path, cache_root: Path) -> Path:
    identity = hashlib.sha256(str(project).encode("utf-8")).hexdigest()
    return cache_root / "projects" / f"{safe_basename(project.name)}-{identity[:16]}"


def metadata(path: Path, *, digest: bool) -> dict[str, object]:
    try:
        value = path.lstat()
    except FileNotFoundError:
        return {"state": "missing"}
    kind = (
        "symlink"
        if stat.S_ISLNK(value.st_mode)
        else "directory"
        if stat.S_ISDIR(value.st_mode)
        else "file"
        if stat.S_ISREG(value.st_mode)
        else "other"
    )
    result: dict[str, object] = {
        "state": "present",
        "type": kind,
        "uid": value.st_uid,
        "gid": value.st_gid,
        "mode": f"{stat.S_IMODE(value.st_mode):04o}",
        "device": value.st_dev,
        "inode": value.st_ino,
        "size": value.st_size,
    }
    if kind == "symlink":
        result["target"] = os.readlink(path)
    elif digest and kind == "file":
        hasher = hashlib.sha256()
        with path.open("rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                hasher.update(chunk)
        result["sha256"] = hasher.hexdigest()
    return result


def tree(path: Path, *, digest_files: bool) -> dict[str, object]:
    result: dict[str, object] = {".": metadata(path, digest=digest_files)}
    if result["."]["state"] == "missing":  # type: ignore[index]
        return result
    for directory, names, files in os.walk(path, followlinks=False):
        names.sort()
        files.sort()
        base = Path(directory)
        for name in (*names, *files):
            entry = base / name
            relative = entry.relative_to(path).as_posix()
            result[relative] = metadata(entry, digest=digest_files)
    return result


def ancestors(path: Path) -> dict[str, object]:
    chain: list[Path] = []
    current = path
    while True:
        chain.append(current)
        if current.parent == current:
            break
        current = current.parent
    return {str(item): metadata(item, digest=False) for item in reversed(chain)}


def main() -> int:
    args = parse_args()
    project = canonical_directory(args.constructor_project, "constructor project")
    primary = canonical_directory(args.primary_workspace, "primary workspace")
    extras = [
        canonical_directory(path, "extra workspace") for path in args.extra_workspace
    ]
    unrelated = [path.resolve(strict=False) for path in args.unrelated]
    cache_root = (
        (args.cache_root or default_cache_root()).expanduser().resolve(strict=False)
    )
    namespace = project_namespace(project, cache_root)

    evidence = {
        "schema_version": 1,
        "label": args.label,
        "collected_at": datetime.now(timezone.utc).isoformat(),
        "invoking_user": {"uid": os.geteuid(), "gid": os.getegid()},
        "paths": {
            "constructor_project": str(project),
            "primary_workspace": str(primary),
            "extra_workspaces": [str(path) for path in extras],
            "cache_root": str(cache_root),
            "project_namespace": str(namespace),
            "unrelated": [str(path) for path in unrelated],
        },
        "trees": {
            "constructor_project": tree(project, digest_files=False),
            "primary_workspace": tree(primary, digest_files=False),
            "extra_workspaces": {
                str(path): tree(path, digest_files=False) for path in extras
            },
            # Hash external regular files so blobs and project.json can be shown
            # byte-identical as well as ownership/mode/inode-identical.
            "project_namespace": tree(namespace, digest_files=True),
            "unrelated": {
                str(path): tree(path, digest_files=False) for path in unrelated
            },
        },
        "ancestors": {
            "constructor_project": ancestors(project),
            "primary_workspace": ancestors(primary),
            "extra_workspaces": {str(path): ancestors(path) for path in extras},
            "cache_root": ancestors(cache_root),
            "project_namespace": ancestors(namespace),
            "unrelated": {str(path): ancestors(path) for path in unrelated},
        },
    }

    args.output.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    try:
        descriptor = os.open(args.output, flags, 0o600)
    except FileExistsError:
        raise SystemExit(
            f"error: refusing to overwrite evidence: {args.output}"
        ) from None
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        json.dump(evidence, stream, indent=2, sort_keys=True)
        stream.write("\n")
    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
